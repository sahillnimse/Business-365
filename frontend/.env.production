# On Vercel, frontend and backend share the same domain
# so API calls are relative — no CORS issues
VITE_API_URL=

# Microsoft Azure AD — keep same as local
VITE_AZURE_CLIENT_ID=34f6d960-09e3-47a3-9783-7ae8bac4bf46
VITE_AZURE_TENANT_ID=99096dce-9dea-4f18-b4bb-b586eea333ee

# Update this to your Vercel domain after first deploy
# e.g. https://business-365.vercel.app
VITE_AZURE_REDIRECT_URI=https://business-365-eight.vercel.app
